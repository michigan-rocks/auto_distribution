{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {"type": "grafana", "uid": "-- Grafana --"},
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "tasks/s",
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 12,
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": true
          },
          "min": 0,
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "options": {
        "legend": {"calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (worker_id) (rate(optotech_worker_tasks_completed_total[$__rate_interval]))",
          "legendFormat": "worker {{worker_id}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Worker throughput",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "queued tasks",
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 18,
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": true
          },
          "decimals": 0,
          "min": 0,
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "options": {
        "legend": {"calcs": ["max"], "displayMode": "table", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (worker_id) (label_replace(rabbitmq_queue_messages_ready{queue=~\".*\\\\.worker\\\\.[123]\"}, \"worker_id\", \"$1\", \"queue\", \".*\\\\.worker\\\\.([123])\"))",
          "legendFormat": "worker {{worker_id}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Queued tasks by worker",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "decimals": 0,
          "min": 0,
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 9},
      "id": 3,
      "options": {
        "displayMode": "gradient",
        "maxVizHeight": 300,
        "minVizHeight": 16,
        "minVizWidth": 8,
        "namePlacement": "auto",
        "orientation": "horizontal",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "showUnfilled": true,
        "sizing": "auto",
        "valueMode": "color"
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (worker_id) (optotech_worker_tasks_completed_total)",
          "instant": true,
          "legendFormat": "worker {{worker_id}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Completed tasks by worker",
      "type": "bargauge"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Average of retained completed JSON reports for the selected workload.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "continuous-GrYlRd"},
          "decimals": 3,
          "min": 0,
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 9},
      "id": 4,
      "options": {
        "displayMode": "gradient",
        "maxVizHeight": 300,
        "minVizHeight": 16,
        "minVizWidth": 8,
        "namePlacement": "auto",
        "orientation": "horizontal",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "showUnfilled": true,
        "sizing": "auto",
        "valueMode": "color"
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "avg by (alpha, window) (benchmark_elapsed_seconds{mode=\"adaptive\",status=\"completed\",workload=~\"$workload\",run_date=~\"$run_date\",alpha!=\"\"})",
          "instant": true,
          "legendFormat": "alpha={{alpha}}, window={{window}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Average benchmark time by alpha/window",
      "type": "bargauge"
    }
  ],
  "refresh": "1s",
  "schemaVersion": 41,
  "tags": ["benchmark", "adaptive", "rabbitmq"],
  "templating": {
    "list": [
      {
        "allValue": ".*",
        "current": {"selected": true, "text": "All", "value": "$__all"},
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "definition": "label_values(benchmark_elapsed_seconds, workload)",
        "includeAll": true,
        "label": "Workload",
        "name": "workload",
        "options": [],
        "query": {"query": "label_values(benchmark_elapsed_seconds, workload)", "refId": "PrometheusVariableQueryEditor-VariableQuery"},
        "refresh": 1,
        "regex": "",
        "sort": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "current": {"selected": true, "text": "All", "value": "$__all"},
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "definition": "label_values(benchmark_elapsed_seconds, run_date)",
        "includeAll": true,
        "label": "Run date",
        "name": "run_date",
        "options": [],
        "query": {"query": "label_values(benchmark_elapsed_seconds, run_date)", "refId": "PrometheusVariableQueryEditor-VariableQuery"},
        "refresh": 1,
        "regex": "",
        "sort": 2,
        "type": "query"
      }
    ]
  },
  "time": {"from": "now-15m", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "Adaptive benchmark observability",
  "uid": "adaptive-benchmark",
  "version": 1,
  "weekStart": ""
}
